  "properties": {
    "run_metadata": {"type":"object","required":["run_id","interface_version"],"properties":{"run_id":{"type":"string"},"interface_version":{"const":"composer-interface-v1.1"}},"additionalProperties":true},
    "status": {"enum":["READY_FOR_VALIDATION","BLOCKED"]},
    "decision_trace": {"type":"array","minItems":1,"items":{"type":"object","required":["decision_id","domain","artistic_goal","question","scope","candidate_options","hard_constraints","soft_criteria","structural_basis","perceptual_basis","composition_basis","selected_option","selection_basis","active_intention","tradeoff","dependencies","songplan_handoff","uncertainty","provenance"],"properties":{"decision_id":{"type":"string"},"domain":{"type":"string"},"artistic_goal":{},"question":{"type":"string"},"scope":{},"candidate_options":{"type":"array"},"hard_constraints":{"type":"array"},"soft_criteria":{"type":"array"},"structural_basis":{},"perceptual_basis":{},"composition_basis":{},"selected_option":{},"selection_basis":{"enum":["BRIEF_CONSTRAINT","EXPORTED_KNOWLEDGE_FILTER","RANK_1_AUTHORIZED","ARTISTIC_PRIORITY","OWNER_EXPLICIT_DECISION"]},"active_intention":{},"tradeoff":{},"dependencies":{"type":"array"},"songplan_handoff":{},"uncertainty":{},"provenance":{"type":"array"}},"additionalProperties":true}},
    "resolved_major_decisions":{"type":"array","minItems":1,"items":{"type":"object","required":["decision_id","selected_option","selection_basis","trace_reference"],"properties":{"decision_id":{"type":"string"},"selected_option":{},"selection_basis":{"type":"string"},"trace_reference":{"type":"string"}},"additionalProperties":true}},
    "artistic_priority_handoffs":{"type":"array","items":{"type":"object","required":["decision_id","surviving_options","selected_option","active_intention","tradeoff","superiority_claim"],"properties":{"decision_id":{"type":"string"},"surviving_options":{"type":"array"},"selected_option":{},"active_intention":{"type":"string"},"tradeoff":{"type":"string"},"superiority_claim":{"const":false}},"additionalProperties":true}},
    "capability_declarations":{"type":"array","minItems":1,"items":{"type":"object","required":["enumerate","filter","rank_1","rank_2","basis"],"properties":{"enumerate":{"type":"boolean"},"filter":{"type":["boolean","string"]},"rank_1":{"type":"object","required":["used","knowledge_id","task","target_construct","criterion","scope","evidence_basis","non_claim"],"properties":{"used":{"type":"boolean"},"knowledge_id":{"type":["string","null"]},"task":{"type":["string","null"]},"target_construct":{"type":["string","null"]},"criterion":{"type":["string","null"]},"scope":{"type":["string","null"]},"evidence_basis":{"type":["string","null"]},"non_claim":{"type":["string","null"]}},"additionalProperties":true},"rank_2":{"const":"UNAVAILABLE"},"basis":{"type":"string"}},"additionalProperties":true}},
    "guardrail_results":{"type":"array","minItems":1,"items":{"type":"object","required":["guardrail_id","status","evidence","affected_decisions","resolution_or_block"],"properties":{"guardrail_id":{"type":"string"},"status":{"enum":["PASS","WARNING","BLOCK","NOT_APPLICABLE"]},"evidence":{"type":"string"},"affected_decisions":{"type":"array"},"resolution_or_block":{}},"additionalProperties":true}},
    "uncertainties":{"type":"array"},
    "completion_checklist":{"type":"array","minItems":14,"maxItems":14,"items":{"type":"object","required":["decision","status","decision_id","selected_option_or_block_reason","trace_reference"],"properties":{"decision":{"type":"string"},"status":{"enum":["RESOLVED","BLOCKED","NOT_APPLICABLE"]},"decision_id":{"type":"string"},"selected_option_or_block_reason":{},"trace_reference":{"type":"string"}},"additionalProperties":false}},
    "n3_p_decision":{"type":"object","required":["decision_id","candidate_strategies","selected_outcome","selection_basis","bass_groove_interaction","focal_hierarchy_interaction","section_behavior","development_behavior"],"properties":{"decision_id":{"type":"string","minLength":1},"candidate_strategies":{"type":"array","minItems":1},"selected_outcome":{"enum":["FULL","MINIMAL","DELEGATED","INTENTIONALLY_ABSENT"]},"selection_basis":{"type":"string","minLength":1},"bass_groove_interaction":{"type":"string","minLength":1},"focal_hierarchy_interaction":{"type":"string","minLength":1},"section_behavior":{"type":"string","minLength":1},"development_behavior":{"type":"string","minLength":1}},"additionalProperties":true},
    "songplan_candidate":{"oneOf":[{"type":"object","required":["schema_version","name","tempo","time_signature","tonic","mode","style","arrangement","tracks"],"properties":{"schema_version":{"const":"2.0"},"name":{"type":"string","minLength":1},"tempo":{"type":"number","exclusiveMinimum":0},"time_signature":{"oneOf":[{"type":"object","required":["numerator","denominator"],"properties":{"numerator":{"type":"integer","minimum":1},"denominator":{"type":"integer","minimum":1}},"additionalProperties":false},{"type":"string"}]},"tonic":{"type":"string","minLength":1},"mode":{"enum":["ionian","dorian","phrygian","lydian","mixolydian","aeolian","locrian"]},"style":{"type":"string","minLength":1},"arrangement":{"type":"object","required":["sections","harmony_assignments"],"properties":{"sections":{"type":"array"},"harmony_assignments":{"type":"array"}},"additionalProperties":false},"tracks":{"type":"array","items":{"type":"object","required":["id","type","role","motifs","section_assignments"],"properties":{"id":{"type":"string"},"type":{"enum":["pitched","drums","percussion","effect"]},"role":{"type":"string"},"motifs":{"type":"array"},"section_assignments":{"type":"array"}},"additionalProperties":true}}},"additionalProperties":false},{"type":"null"}]}
  }
}
